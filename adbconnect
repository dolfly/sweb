#!/bin/bash
net=${NET:-192.168.120}
port=5555
for i in {1..254}; do
    ip="${net}.${i}"
    if ping -c 1 -w 1 "${ip}" 2>/dev/null && nc -z -w 1 "${ip}" "${port}"; then
        adb connect "${ip}:${port}"
    fi    
done
# disconnect unauthorized device
adb devices  | grep -E "unauthorized|offline"  |cut -f1  | while  read -r  line ; do  
    adb disconnect "${line}";
done

pm2 restart sweb